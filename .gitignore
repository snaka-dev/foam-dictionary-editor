# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# foam dictionary editor settings for user
app_config.json

# Generated mesh and run logs inside bundled example cases
tutorials/**/constant/polyMesh/
tutorials/**/log.*

### This will be needed future update
# User-generated keyword list (overrides the tracked foam_keywords.default.json)
#app_config/foam_keywords.json

# Local scratch files
*.patch

# Claude Code per-machine tool settings (local paths; not part of the release)
.claude/settings.local.json

#Python environment
venv/

# Python bytecode caches, at every level of the tree
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# xterm.js downloaded assets (auto-fetched on first terminal open)
ui/xterm/

# Applications
*.app
*.exe
*.war

# Large media files
*.mp4
*.tiff
*.avi
*.flv
*.mov
*.wmv

