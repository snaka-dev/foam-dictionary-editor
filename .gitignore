# These are some examples of commonly ignored file patterns.
# You should customize this list as applicable to your project.
# Learn more about .gitignore:
#     https://www.atlassian.com/git/tutorials/saving-changes/gitignore

# foam dictionary editor settings for user
app_config.json
schema_config.json

#Python environment
venv/
.venv/

# Python interpreter to store compiled bytecode files (.pyc files)
__pycache__/
*.pyc

# Nuitka
main.onefile-build/
main.dist/
main.build/

# Serena MCP
.serena/

# Node artifact files
node_modules/
dist/

# Compiled Java class files
*.class

# Compiled Python bytecode
*.py[cod]

# Log files
*.log

# Package files
*.jar

# Maven
target/
dist/

# JetBrains IDE
.idea/

# Unit test reports
TEST*.xml

# Generated by MacOS
.DS_Store

# Generated by Windows
Thumbs.db

# xterm.js downloaded assets (auto-fetched on first terminal open)
ui/xterm/
ui/widgets/xterm/

# Applications
*.app
*.exe
*.war

# Large media files
# Demo movies land in docs/demo/ and are deliberately not tracked: they are
# regenerated from tools/demo_specs.json, video does not delta-compress, and a
# retake is a whole new blob in history forever. The published copies live on
# YouTube (linked from docs/DEMO_SCRIPTS.md); the .srt files beside them *are*
# tracked, being a couple of kilobytes of text and the caption track to upload.
*.mp4
*.gif
*.webm
*.mkv
*.tiff
*.avi
*.flv
*.mov
*.wmv


# Claude Code per-user local settings
.claude/settings.local.json

# Generated mesh and run logs inside bundled example cases
tutorials/**/constant/polyMesh/
tutorials/**/log.*

# User-generated keyword list (overrides the tracked foam_keywords.default.json)
app_config/foam_keywords.json

# Local scratch files
*.patch
