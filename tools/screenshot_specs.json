        ],
        "current_file": "system/surfaces",
        "tree_selection": [
          "surfaces",
          "midCut",
          "normal"
        ],
        "splitter_sizes": {
          "right": [
            460,
            260
          ]
        },
        "block_mesh": {
          "toggles": {
            "boundary_faces": false,
            "vertex_table": false
          },
          "label_font_size": 14,
          "camera": [
            [
              6.31,
              -3.49,
              4.71
            ],
            [
              1.5,
              1.5,
              1.5
            ],
            [
              0.0,
