    },
    "tools-menu": {
      "note": "The Tools menu open over the bundled pitzDaily case. Menu shots grab the screen, cropped to the window's frame.",
      "outputs": {
        "light": "tools-menu.png"
      },
      "open_menu": "Tools",
      "state": {
        "case_dir": "{repo}/tutorials/pitzDaily",
        "current_file": "system/controlDict"
      }
    }
  }
}
